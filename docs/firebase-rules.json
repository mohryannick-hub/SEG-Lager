{
  "rules": {
    ".read": false,
    ".write": false,
    "plans": {
      "$key": {
        ".read": "$key.length >= 20",
        ".write": "$key.length >= 20",
        ".validate": "newData.hasChildren(['json', 'at']) && newData.child('json').isString() && newData.child('json').val().length < 400000"
      }
    }
  }
}
